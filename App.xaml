<Application x:Class="Zapret2Ultra.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0A0C11"/>
    <SolidColorBrush x:Key="Surface" Color="#10141C"/>
    <SolidColorBrush x:Key="Surface2" Color="#151B25"/>
    <SolidColorBrush x:Key="Surface3" Color="#1B2230"/>
    <SolidColorBrush x:Key="Text" Color="#F7F8FB"/>
    <SolidColorBrush x:Key="Muted" Color="#8B95A7"/>
    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Accent2" Color="#A78BFA"/>
    <SolidColorBrush x:Key="Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Danger" Color="#FB7185"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderBrush" Value="#293244"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface2}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
  </Application.Resources>
</Application>
