<Application x:Class="Zapret2Ultra.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Panel" Color="#11151D"/>
    <SolidColorBrush x:Key="Panel2" Color="#171C26"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="Muted" Color="#8992A3"/>
    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Danger" Color="#FB7185"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Application.Resources>
</Application>
